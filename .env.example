# Tableau MCP App - credentials and configuration.
#
# Copy to `.env` (which is gitignored) and fill in. Values here are read at
# startup; anything already exported in your shell wins over this file, so a
# one-off override still works without editing it.
#
#   cp .env.example .env
#
# Never commit the filled-in .env. The secret value in particular is shown once
# by Tableau Cloud at creation and cannot be read back.

# --- Which dashboard to embed -------------------------------------------------
# Tableau Cloud's address bar shows /#/site/<site>/views/... - that form does NOT
# embed. Use the /t/<site>/views/<workbook>/<view> form below.
# Leave unset to embed the published Tableau Public dashboard anonymously.
TABLEAU_VIZ_URL=https://<pod>.online.tableau.com/t/<site>/views/<workbook>/<view>

# --- Direct Trust Connected App ----------------------------------------------
# All four are required together for an authenticated Cloud embed. Delete all
# four lines to fall back to anonymous Tableau Public.
# Create at: Tableau Cloud -> Settings -> Connected Apps -> Direct Trust.
#
# Replace the whole <...> including the angle brackets. Leaving a placeholder is
# caught by the startup preflight, which names every unfilled key at once.
# Do NOT blank a value out to `KEY=` - a partially filled set is a hard error,
# and an empty line reads as "not set" rather than "set to nothing".
TABLEAU_CONNECTED_APP_CLIENT_ID=<client-id-uuid>
TABLEAU_CONNECTED_APP_SECRET_ID=<secret-id-uuid>
TABLEAU_CONNECTED_APP_SECRET_VALUE=<secret-value-shown-once-at-creation>
TABLEAU_EMBED_USER=you@example.com

# --- Optional -----------------------------------------------------------------
# EMBED_DEBUG=1                  # on-screen diagnostic panel (a diagnostic YOU read)
# EMBED_PROBE_MESSAGES=1         # probe JSON into the chat (content the MODEL reads).
#                                # Leave OFF for a scoping test - see SCOPING-TEST.md.
# PORT=8792                      # HTTP transport port
# TABLEAU_SKIP_PREFLIGHT=1       # static preflight checks only, no network call
# TABLEAU_PREFLIGHT_STRICT=1     # exit non-zero when preflight finds a problem
# TABLEAU_REST_API_VERSION=3.29  # Tableau Cloud 2026.2.5 speaks 3.29
